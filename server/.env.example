# =============================================================================
# Node.js ERP Backend - Environment Variables Configuration
# =============================================================================
# This file documents all environment variables used by the application.
# Copy this file to .env and update the values for your environment.
# NEVER commit the actual .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONMENT MODE
# -----------------------------------------------------------------------------

# Application environment mode
# Options: 'development' | 'production' | 'test'
# Default: 'development'
# Note: In production, this must be set to 'production' for security features
NODE_ENV=production

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------

# Port number on which the server will listen
# Default: 4000
# Optional: Can be omitted in development, but recommended to set explicitly
PORT=4000

# -----------------------------------------------------------------------------
# JWT CONFIGURATION
# -----------------------------------------------------------------------------

# Secret key used to sign and verify JWT tokens
# ⚠️  MANDATORY IN PRODUCTION: Must be set to a strong, random string
# Generate a secure secret: openssl rand -base64 32
# Minimum recommended length: 32 characters
# Security: Never use default or weak values in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# JWT token expiration time
# Format: Number followed by unit (s=seconds, m=minutes, h=hours, d=days)
# Examples: '1d', '24h', '3600s', '7d'
# Default: '1d' (1 day)
# Optional: Can be omitted to use default
JWT_EXPIRES_IN=1d

# -----------------------------------------------------------------------------
# PASSWORD HASHING
# -----------------------------------------------------------------------------

# Number of bcrypt rounds for password hashing
# Higher values = more secure but slower (exponential time increase)
# Recommended: 10-12 for production (balance between security and performance)
# Default: 10
# Optional: Can be omitted to use default
# Warning: Changing this value will invalidate all existing passwords
BCRYPT_ROUNDS=10

# -----------------------------------------------------------------------------
# DATABASE CONNECTION
# -----------------------------------------------------------------------------

# Database host address
# Default: 'localhost' (development fallback)
# ⚠️  REQUIRED: Must be set explicitly in production
# Examples: 'localhost', 'db.example.com', '192.168.1.100'
DB_HOST=localhost

# Database username
# Default: 'root' (development fallback)
# ⚠️  REQUIRED: Must be set explicitly in production
# Security: Use a dedicated database user with minimal required permissions
DB_USER=nbaurum_user

# Database password
# Default: '' (empty string - development fallback)
# ⚠️  REQUIRED IN PRODUCTION: Must be set to a strong password
# Security: Use a strong, unique password for production databases
# Note: Can be empty string for local development without password
DB_PASSWORD=Nbaurum@2026

# Database name
# Default: 'erp_db' (development fallback)
# ⚠️  REQUIRED: Must be set explicitly in production
DB_NAME=nbaurum_erp

# Database port number
# Default: 3306 (MySQL/MariaDB standard port)
# Optional: Can be omitted if using standard MySQL port
# Note: Change if using a non-standard port or different database system
DB_PORT=3306

# Maximum number of retry attempts for database connection during startup
# Default: 5 attempts
# Optional: Can be omitted to use default
# Note: Uses exponential backoff between retries
DB_MAX_RETRY_ATTEMPTS=5

# Initial delay (in milliseconds) before first retry attempt
# Default: 1000 (1 second)
# Optional: Can be omitted to use default
# Note: Delay increases exponentially with each retry (multiplied by DB_RETRY_MULTIPLIER)
DB_INITIAL_RETRY_DELAY_MS=1000

# Maximum delay (in milliseconds) between retry attempts
# Default: 30000 (30 seconds)
# Optional: Can be omitted to use default
# Note: Prevents excessive delays even with exponential backoff
DB_MAX_RETRY_DELAY_MS=30000

# Multiplier for exponential backoff calculation
# Default: 2 (doubles delay with each retry)
# Optional: Can be omitted to use default
# Example: With initial delay 1000ms and multiplier 2, delays are: 1s, 2s, 4s, 8s, 16s...
DB_RETRY_MULTIPLIER=2

# Maximum number of concurrent database connections in the pool
# Default: 10 connections
# Optional: Can be omitted to use default
# Recommendation: Adjust based on database server capacity and expected load
DB_CONNECTION_LIMIT=10

# Maximum number of queued connection requests when pool is exhausted
# Default: 0 (unlimited queue)
# Optional: Can be omitted to use default
# Note: Set to a positive number to limit queue size and fail fast when overloaded
DB_QUEUE_LIMIT=0

# Connection timeout (in milliseconds) for establishing new database connections
# Default: 10000 (10 seconds)
# Optional: Can be omitted to use default
# Note: Timeout for initial connection handshake
DB_CONNECT_TIMEOUT=10000

# Connection acquisition timeout (in milliseconds) when waiting for available connection
# Default: 60000 (60 seconds)
# Optional: Can be omitted to use default
# Note: Timeout when pool is exhausted and waiting for a connection to become available
DB_ACQUIRE_TIMEOUT=60000

# -----------------------------------------------------------------------------
# RATE LIMITING CONFIGURATION
# -----------------------------------------------------------------------------

# General API rate limit window in milliseconds
# This is the time window for counting requests
# Default: 900000 (15 minutes = 15 * 60 * 1000)
# Optional: Can be omitted to use default
# Example: 900000 = 15 minutes, 3600000 = 1 hour
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests allowed per IP per rate limit window
# Applies to general API endpoints (excluding auth and profile endpoints)
# Default: 300 requests per window
# Optional: Can be omitted to use default
# Recommendation: Adjust based on your API usage patterns and server capacity
RATE_LIMIT_MAX=300

# Maximum number of authentication requests allowed per window
# Applies specifically to login, register, and password reset endpoints
# Default: 50 requests per window
# Optional: Can be omitted to use default
# Security: Lower values provide better protection against brute force attacks
# Note: Only failed authentication attempts count toward this limit
AUTH_RATE_LIMIT_MAX=50

# Authentication rate limit window in milliseconds
# Time window for counting authentication attempts
# Default: 900000 (15 minutes = 15 * 60 * 1000)
# Optional: Can be omitted to use default
# Note: In development, this is automatically set to 1 minute for easier testing
AUTH_RATE_LIMIT_WINDOW_MS=900000

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------

# Comma-separated list of allowed origins for CORS
# ⚠️  MANDATORY IN PRODUCTION: Must be set to your frontend domain(s)
# Format: Comma-separated URLs without trailing slashes
# Examples:
#   Single origin: 'https://app.example.com'
#   Multiple origins: 'https://app.example.com,https://admin.example.com'
#   With ports: 'https://app.example.com:3000,https://app.example.com:8080'
# Default (development): 'http://localhost:5173,http://localhost:3000'
# Default (production): Empty array (will deny all requests if not set)
# Security: Only include trusted frontend domains. Never use wildcards in production.
# Note: Origins are trimmed of whitespace automatically
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to production, ensure the following are set:
#
# ✅ NODE_ENV=production
# ✅ JWT_SECRET (strong random string, min 32 characters)
# ✅ DB_HOST (production database host)
# ✅ DB_USER (production database user)
# ✅ DB_PASSWORD (strong database password)
# ✅ DB_NAME (production database name)
# ✅ ALLOWED_ORIGINS (your frontend domain(s))
#
# Optional but recommended:
# ✅ PORT (if not using default 4000)
# ✅ JWT_EXPIRES_IN (if default 1d is not suitable)
# ✅ BCRYPT_ROUNDS (if default 10 is not suitable)
# ✅ Rate limiting variables (if defaults don't fit your needs)
# =============================================================================

