# =============================================================================
# React (Vite) Frontend - Environment Variables Configuration
# =============================================================================
# This file documents all environment variables used by the frontend application.
# Copy this file to .env and update the values for your environment.
# NEVER commit the actual .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# API CONFIGURATION
# -----------------------------------------------------------------------------

# Backend API base URL (without /api/v1 path)
# ⚠️  REQUIRED: Must be set to your backend server URL
# 
# Development (local):
#   VITE_API_BASE_URL=http://localhost:4000
# 
# Production:
#   VITE_API_BASE_URL=https://api.yourdomain.com
# 
# Note: The /api/v1 path is automatically appended by the API client
# Do NOT include /api/v1 in this URL
# 
# Default (development fallback): http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# APPLICATION METADATA
# -----------------------------------------------------------------------------

# Application name displayed in the UI
# Optional: Can be omitted if not needed
VITE_APP_NAME=NBAURUM ERP

# Application version
# Optional: Can be omitted if not needed
VITE_APP_VERSION=1.0.0

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to production, ensure the following are set:
#
# ✅ VITE_API_BASE_URL (your production backend URL)
#
# Optional but recommended:
# ✅ VITE_APP_NAME (if you want to customize the app name)
# ✅ VITE_APP_VERSION (if you want to track version in the UI)
# =============================================================================

